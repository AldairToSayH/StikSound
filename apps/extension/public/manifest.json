{
  "manifest_version": 3,
  "name": "StikSound",
  "version": "1.0.0",
  "description": "Attach a 5-second sound clip to an existing sticker locally and export a video.",
  "action": {
    "default_title": "StikSound"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["downloads", "storage"],
  "host_permissions": [
    "https://www.myinstants.com/*",
    "https://myinstants.com/*"
  ]
}
