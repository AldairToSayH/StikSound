{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StikSound",
  "version": "1.0.0",
  "identifier": "app.stiksound.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StikSound",
        "width": 440,
        "height": 540,
        "resizable": true,
        "minWidth": 360,
        "minHeight": 460
      }
    ],
    "security": {
      "csp": "default-src 'self' blob: data:; img-src 'self' blob: data:; media-src 'self' blob: data:; connect-src https://www.myinstants.com https://myinstants.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
